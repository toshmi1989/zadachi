# Пароль первого администратора (логин admin). Применяется один раз, при первом запуске; дальше
# пользователи и пароли ведутся на странице «Пользователи». Не короче 8 символов.
# Если не задан — пароль будет сгенерирован и напечатан один раз в журнале контейнера (docker logs zadachi).
APP_PASSWORD=

# Напоминания в Telegram (необязательно). Токен выдаёт @BotFather; нужен отдельный бот для этой платформы.
# Никому не отправляйте токен и не коммитьте этот файл.
# TELEGRAM_BOT_TOKEN=
